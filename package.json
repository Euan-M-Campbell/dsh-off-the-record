{
  "name": "dsh-off-the-record",
  "description": "Keeps your DeepSeek Harness sessions, secrets, and searches off DeepSeek's record",
  "version": "0.6.1",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "privacy",
    "telemetry",
    "searxng",
    "brave-search",
    "secrets"
  ],
  "author": "Euan-M-Campbell (https://github.com/Euan-M-Campbell)",
  "homepage": "https://github.com/Euan-M-Campbell/dsh-off-the-record#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Euan-M-Campbell/dsh-off-the-record.git"
  },
  "bugs": {
    "url": "https://github.com/Euan-M-Campbell/dsh-off-the-record/issues"
  },
  "license": "MIT",
  "type": "module",
  "icon": "./assets/icon.svg",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/otr-settings/index.d.ts",
      "default": "./lib/otr-settings/index.js"
    },
    "./web-search-searxng": {
      "types": "./lib/types/web-search-searxng/index.d.ts",
      "default": "./lib/web-search-searxng/index.js"
    },
    "./web-search-brave": {
      "types": "./lib/types/web-search-brave/index.d.ts",
      "default": "./lib/web-search-brave/index.js"
    },
    "./vault": {
      "types": "./lib/types/vault/index.d.ts",
      "default": "./lib/vault/index.js"
    },
    "./vault-local": {
      "types": "./lib/types/vault-local/index.d.ts",
      "default": "./lib/vault-local/index.js"
    },
    "./tool-vault": {
      "types": "./lib/types/tool-vault/index.d.ts",
      "default": "./lib/tool-vault/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./web-search-searxng/locale/*.json": "./locale/web-search-searxng/*.json",
    "./web-search-searxng/icon": "./assets/searxng.svg",
    "./web-search-brave/locale/*.json": "./locale/web-search-brave/*.json",
    "./web-search-brave/icon": "./assets/brave.svg",
    "./vault-local/locale/*.json": "./locale/vault-local/*.json",
    "./vault-local/icon": "./assets/vault.svg",
    "./tool-vault/locale/*.json": "./locale/tool-vault/*.json",
    "./tool-vault/icon": "./assets/tools.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "patches",
    "locale",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./patches/off-the-record.patch.yml",
        "./patches/disable-telemetry.patch.yml",
        "./patches/private-search.patch.yml",
        "./patches/secrets-vault.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-base": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-mock-server": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell-env": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "immer": "10.2.0",
    "js-yaml": "^4.3.2",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "4.4.3",
    "zustand": "4.5.7"
  }
}
