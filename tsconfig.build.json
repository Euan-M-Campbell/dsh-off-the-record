{
  // Declarations only; tsdown emits the JavaScript.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": ["src"],
  // The browser half is bundled separately and ships no declarations.
  "exclude": ["src/client"]
}
