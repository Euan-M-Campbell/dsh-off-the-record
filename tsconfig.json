{
  // Compiler options follow the harness's tsconfig.base.json so plugin code reads the same in both repositories.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // The browser half (src/client) is React; the Host half never touches the DOM.
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"]
  },
  "include": ["src", "tests", "scripts"]
}
